{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,

  // Test Explorer (the beaker icon): the same tests as `python -m unittest discover -s tests`
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": ["-v", "-s", "./tests", "-p", "test_*.py"],

  "terminal.integrated.env.windows": { "PYTHONIOENCODING": "utf-8" },

  // keep search results to source, not to copies of results
  "search.exclude": {
    "**/__pycache__": true,
    "runs/*/outputs": true,
    "outputs_smoke": true,
    "mlartifacts": true
  },
  "files.exclude": { "**/__pycache__": true },
  "files.associations": { "*.log": "log" },
  "markdown.preview.breaks": false
}
